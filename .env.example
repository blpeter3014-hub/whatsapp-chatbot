# Copia este archivo a .env y llena los valores. NUNCA subas .env a GitHub.

# Token que tú inventas; debe ser igual al "Identificador de verificación" en Meta
META_VERIFY_TOKEN=whatsapp_verificacion_2026

# Identificador de acceso generado en Meta (Paso 1. Probar). Dura 24 h en pruebas.
WHATSAPP_TOKEN=

# "Phone Number ID" del número de prueba (NO es el número de teléfono)
PHONE_NUMBER_ID=

# Opcional: App Secret (Configuración de la app > Básica) para validar la firma de Meta
META_APP_SECRET=

# Modelo de Ollama
OLLAMA_MODEL=qwen3.5:2b-q4_K_M

# PostgreSQL (si lo dejas vacío, el historial se guarda solo en memoria)
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/biaani_chatbot

GRAPH_VERSION=v26.0
HISTORY_LIMIT=10
